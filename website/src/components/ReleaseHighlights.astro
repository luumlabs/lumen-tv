---
import type { Locale } from "../data/lang";
import { brand } from "../data/site";
interface Props { locale: Locale }
const zh = Astro.props.locale === "zh";
const items = zh ? [
  ["01", "把同类应用，放在一起。", "长按应用创建文件夹，视频、音乐、工具各有位置。"],
  ["02", "桌面与投屏，一起更新。", "进入设置里的「软件更新与投屏」，检查新版本或开启自动更新。"],
  ["03", "换上自己的头像。", "手机扫码上传；下滑进入全部应用时，背景化成磨砂玻璃。"],
] : [
  ["01", "A place for every app.", "Long-press to organize video, music and tools into folders."],
  ["02", "One place to stay current.", "Check Tigris and MiracastReceiver in Settings → Software updates & casting."],
  ["03", "Make it yours.", "Upload an avatar from your phone. Scroll down into a frosted app library."],
];
---
<section class="release-strip wrap" aria-label={zh ? "本次更新" : "Latest update"}>
  <a class="release-pill" href={brand.releases}><span class="dot"></span>{zh ? "全部版本" : "All releases"} ↗</a>
  <div class="release-grid">{items.map(([n,title,body]) => <article><span class="release-number">{n}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
</section>
