<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext stays allowed: the BRAVIA API on 127.0.0.1 and wallpaper links people add themselves.
     Apple's aerial films (sylvan.apple.com) chain to Apple Root CA, which Android does not ship,
     so it is trusted for that host only (raw/apple_root_ca.pem, SHA-256 B0:B1:73:0E:CB:C7:FF:45:05:
     14:2C:49:F1:29:5E:6E:DA:6B:CA:ED:7E:2C:68:C5:BE:91:B5:A1:10:01:F0:24, valid until 2035). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">sylvan.apple.com</domain>
        <trust-anchors>
            <certificates src="@raw/apple_root_ca" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
